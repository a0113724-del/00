    { "fg": "on-warning", "bg": "warning", "min": 4.5 },
    { "fg": "warning", "bg": "surface", "min": 3.0 },
    { "fg": "info", "bg": "surface", "min": 4.5 },
    { "fg": "border-input", "bg": "surface", "min": 3.0 },
