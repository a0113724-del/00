  "font": {
    "family": {
      "sans": "'IBM Plex Sans Arabic', 'IBM Plex Sans', system-ui, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace"
    },
    "size":   { "xs": "12px", "sm": "14px", "md": "16px", "lg": "20px", "xl": "28px", "2xl": "40px" },
    "line":   { "xs": "18px", "sm": "22px", "md": "26px", "lg": "30px", "xl": "38px", "2xl": "50px" },
    "weight": { "regular": 400, "medium": 500, "semibold": 600, "bold": 700 }
  },
  "space": { "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px" },
  "radius": { "sm": "6px", "md": "10px", "lg": "16px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgb(0 0 0 / 0.25)",
    "md": "0 6px 20px rgb(0 0 0 / 0.30)",
    "glow": "0 0 0 1px rgb(227 179 65 / 0.35), 0 8px 28px rgb(227 179 65 / 0.12)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
  "layout": { "max-content": "1120px", "max-mobile": "480px", "tabbar-height": "64px", "header-height": "56px", "breakpoints": { "sm": "640px", "md": "768px", "lg": "1024px" } },
  "pairs": [
